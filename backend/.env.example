# Gemini API key used by insights_agent.py and alternative_agent.py.
GEMINI_API_KEY=your_gemini_api_key_here

# ScraperAPI key used as a fallback Amazon product provider when
# direct extraction is blocked/geo-gated (AmazonBlockedError).
SCRAPERAPI_KEY=

# Deployed frontend origin(s) allowed by CORS. Comma-separate
# multiple origins, e.g.:
# FRONTEND_URL=https://shopwise.example.com,http://localhost:3000
FRONTEND_URL=http://localhost:3000
